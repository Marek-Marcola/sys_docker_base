ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG REPO
ARG VER
ARG DURL
ARG DOPT

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM
ENV PATH /usr/local/etcd-$VER:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  groupadd -g 470 etcd;\
  useradd -u 470 -g 470 -c "etcd" -m -s /bin/bash etcd;\
  cd /usr/local;\
  mkdir -pv etcd-$VER;\
  ln -snfv etcd-$VER etcd;\
  curl $DOPT $DURL/sw/opensource/etcd/bin/etcd-v$VER-linux-amd64.tar.gz | tar xzf - --strip-components=1 -C etcd;\
  ls -l /usr/local;\
  etcd --version;

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.from = $FROM";\
 ) > /version.d/version-$REPO.txt;

CMD ["/cmd.sh"]
