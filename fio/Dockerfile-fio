ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG REPO
ARG VER
ARG DURL
ARG DOPT

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM
ENV PATH /usr/local/fio-$VER/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  if expr match $OSN debian; then\
    export DEBIAN_FRONTEND=noninteractive;\
    apt-get update;\
    apt-get -yqq install libaio1t64 libnuma1;\
    apt-get clean;\
    rm -rf /var/lib/apt/lists;\
  fi;\
  cd /usr/local;\
  curl $DOPT $DURL/sw/opensource/fio/bin/fio-$VER-$OSN-$OSA.tar.gz | tar xzf -;\
  ln -snfv fio-$VER fio;\
  mkdir -pv /work;\
  mkdir -pv /usr/local/etc/fio;\
  fio --version;

WORKDIR /work

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.from = $FROM";\
 ) > /version.d/version-$REPO.txt;

COPY scripts/[0-9]*.sh /cmd.d/
CMD ["/cmd.sh"]
