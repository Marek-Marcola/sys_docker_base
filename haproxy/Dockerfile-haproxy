ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG TYPE
ARG REPO
ARG VER
ARG SRC_URI
ARG SRC_OPT

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM
ENV PATH /usr/local/haproxy-$VER/sbin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  if expr "$OSN" : debian; then\
    export DEBIAN_FRONTEND=noninteractive;\
    apt-get update;\
    apt-get -yqq install socat liblua5.4-dev;\
    apt-get clean;\
    rm -rf /var/lib/apt/lists;\
  fi;\
  if expr "$OSN" : centos; then\
    yum -y install socat;\
    yum clean all;\
  fi;\
  groupadd -g 188 haproxy;\
  useradd -r -u 188 -g 188 -m -s /bin/bash haproxy;\
  cd /usr/local;\
  curl $SRC_OPT $SRC_URI/sw/opensource/haproxy/bin/haproxy-$VER-$OSN-$OSA.tar.gz | tar xzf -;\
  ln -snfv haproxy-$VER haproxy;\
  chown -R root:root haproxy-$VER;\
  mkdir -pv etc/haproxy;\
  mkdir -pv /var/opt/haproxy;\
  chown haproxy:haproxy /var/opt/haproxy;\
  S=zlocal-haproxy.sh;\
  curl $SRC_OPT -o /etc/profile.d/$S $SRC_URI/pkb/pb/playbooks/101352-haproxy/files/$S || echo Script $S not available;\
  ls -l /usr/local;\
  haproxy -v;

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.type = ${TYPE:-[none]}";\
  echo "info.from = $FROM";\
 ) > /version.d/version-$REPO.txt;

COPY scripts/[0-9]*.sh /cmd.d/
CMD ["/cmd.sh"]
