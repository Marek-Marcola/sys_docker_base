ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG TYPE
ARG REPO
ARG VER
ARG DURL
ARG DOPT

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  cd /usr/local;\
  curl $DOPT $DURL/sw/oss/hpl/bin/hpl-${VER}${TYPE:+-}${TYPE}-$OSN-$OSA.tar.gz | tar xzf -;\
  ln -snfv hpl-${VER}${TYPE:+-}${TYPE} hpl${TYPE:+-}${TYPE};\
  mkdir -pv /usr/local/etc/modulefiles/hpl;\
  S=hpl_config_N.sh;\
  curl $DOPT -o /usr/local/bin/$S $DURL/pkb/pb/playbooks/101364-hpc_benchmark/files/$S\
    || echo Script $S not available;\
  S=hpl-module-icc;\
  curl $DOPT -o /usr/local/etc/modulefiles/hpl/icc $DURL/pkb/pb/playbooks/101364-hpc_benchmark/files/$S\
    || echo Script $S not available;\
  ls -l /usr/local;

COPY scripts/xhpl.sh /usr/local/bin

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.type = ${TYPE:-[none]}";\
  echo "info.from = $FROM";\
  [ ! -f /tmp/vers.txt ] || (cat /tmp/vers.txt && rm -f /tmp/vers.txt);\
 ) > /version.d/version-$REPO.txt;
