ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG REPO
ARG VER
ARG DURL
ARG DOPT

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM
ENV PATH /usr/local/mediawiki-$VER/maintenance:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  cd /usr/local;\
  curl $DOPT $DURL/sw/oss/mediawiki/${VER%.*}/mediawiki-$VER.tar.gz | tar xzf -;\
  ln -snfv mediawiki-$VER mediawiki;\
  cd mediawiki;\
  mv -v images images.b$(date +%y%m%d);\
  ln -sv /var/opt/mediawiki/images .;\
  ln -sv /var/opt/mediawiki/resources/local resources/;\
  ln -sv /var/opt/mediawiki/LocalSettings.php .;\
  grep MW_VERSION /usr/local/mediawiki/includes/Defines.php;

COPY php7/php.ini /usr/local/etc/php7

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.from = $FROM";\
 ) > /version.d/version-$REPO.txt;

COPY scripts/[0-9]*.sh /cmd.d/
