ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG REPO
ARG VER
ARG DURL
ARG DOPT

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM
ENV PATH /usr/local/mktxp-$VER/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  [ -z "$(id -g none)" ] && groupadd -g 666 none;\
  [ -z "$(id -u none)" ] && useradd -u 666 -g 666 -m -s /bin/bash none;\
  cd /usr/local;\
  curl $DOPT $DURL/sw/opensource/mktxp/bin/mktxp-$VER-$OSN-venv.tar.gz | tar xzf -;\
  ln -snfv mktxp-$VER mktxp;\
  chown -R none:none mktxp-$VER;\
  ln -snfv /usr/local/mktxp/bin/mktxp /usr/local/bin;\
  mkdir -pv /var/opt/mktxp;\
  chown -R none:none /var/opt/mktxp;\
  S=zlocal-mktxp.sh;\
  curl $DOPT -o /etc/profile.d/$S $DURL/pkb/pb/playbooks/908051-mktxp/files/$S || echo Script $S not available;\
  ls -l /usr/local;\
  mktxp info;

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.from = $FROM";\
 ) > /version.d/version-$REPO.txt;

COPY scripts/[0-9]*.sh /cmd.d/
CMD ["/cmd.sh"]
