ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG REPO
ARG VER
ARG DURL
ARG DOPT

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  curl $DOPT -o /as-apps/netxms-websvc.war $DURL/sw/opensource/netxms/war/netxms-websvc-$VER.war;\
  mkdir -pv /usr/local/etc/netxms-websvc;\
  ln -sv /usr/local/etc/netxms-websvc/nxapisrv.properties /as-prop/;\
  ls -l /usr/local;

COPY config/nxapisrv.properties /usr/local/etc/netxms-websvc

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.from = $FROM";\
 ) > /version.d/version-$REPO.txt;

COPY scripts/[0-9]*.sh /cmd.d/
