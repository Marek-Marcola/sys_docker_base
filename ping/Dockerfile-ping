ARG FROM
FROM $FROM

ARG DATE
ARG FROM
ARG REPO
ARG VER

LABEL info.from="$FROM"
LABEL info.name="$REPO:$VER"
LABEL info.date="$DATE"

ENV INFO_DATE=$DATE INFO_REPO=$REPO INFO_VER=$VER INFO_FROM=$FROM
ENV PATH /usr/local/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux;\
  mv -v /cmd.d/190-ep-supervisord.sh.disabled /cmd.d/190-ep-supervisord.sh;\
  if expr "$OSN" : debian; then\
    export DEBIAN_FRONTEND=noninteractive;\
    apt-get update;\
    apt-get -yqq install iputils-ping fping hping3;\
    apt-get clean;\
    rm -rf /var/lib/apt/lists;\
  fi;\
  if expr "$OSN" : centos || expr "$OSN" : rocky; then\
    yum -y update;\
    yum -y install iputils;\
    yum clean all;\
  fi;\
  mkdir -pv /var/opt/ping;\
  ping -V;

RUN set -eux;\
 (echo "info.date = $DATE";\
  echo "info.name = $REPO:$VER";\
  echo "info.from = $FROM";\
 ) > /version.d/version-$REPO.txt;

COPY scripts/[0-9]*.sh /cmd.d/
COPY supervisord/supervisord-* /usr/local/etc/supervisord.d/
CMD ["/cmd.sh"]
